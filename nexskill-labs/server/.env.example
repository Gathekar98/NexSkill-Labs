# Copy this file to .env and fill in real values before running the server.

PORT=5000

# Where lead notification emails get delivered
NOTIFY_EMAIL=ashwinigathekar2704@gmail.com

# Brevo (https://brevo.com) — sends transactional emails over HTTPS,
# which works reliably even on hosts (like Render's free tier) that
# block outbound SMTP ports.
#
# Setup:
#  1. Sign up at brevo.com (free, no credit card)
#  2. Go to Settings -> Senders, Domains & Dedicated IPs -> add a sender
#     using your own email address (e.g. your Gmail) and verify it via
#     the confirmation email Brevo sends you
#  3. Go to SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=ashwinigathekar2704@gmail.com
BREVO_SENDER_NAME=NexSkill Labs

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# Start with TEST mode keys (prefixed rzp_test_) until you're ready to
# accept real payments, then switch to your live keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
